# Only used for previewing the site on this computer (`bundle exec jekyll serve`).
# GitHub Pages ignores this file and builds with its own copy of the same gem.

source "https://rubygems.org"

# The exact Jekyll version, Markdown/Sass settings, and plugin allowlist that
# GitHub Pages runs in production, so the local preview matches the live site.
# The group makes Bundler load its default plugins the way GitHub does.
gem "github-pages", group: :jekyll_plugins
